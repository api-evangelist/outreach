{
    "issuer": "https://api.outreach.io",
    "authorization_endpoint": "https://api.outreach.io/mcpOAuth/authorize",
    "token_endpoint": "https://api.outreach.io/mcpOAuth/token",
    "registration_endpoint": "https://api.outreach.io/mcpOAuth/register",
    "scopes_supported": [
        "prospects.all"
    ],
    "response_types_supported": [
        "code"
    ],
    "grant_types_supported": [
        "authorization_code",
        "refresh_token"
    ],
    "token_endpoint_auth_methods_supported": [
        "client_secret_post"
    ],
    "code_challenge_methods_supported": [
        "S256"
    ]
}
